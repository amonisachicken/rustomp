diff --git a/src/wrapasauv2.cpp b/src/wrapasauv2.cpp
index 2c451b6..1095aa3 100644
--- a/src/wrapasauv2.cpp
+++ b/src/wrapasauv2.cpp
@@ -1027,28 +1027,37 @@ OSStatus WrapAsAUV2::GetPropertyInfo(AudioUnitPropertyID inID, AudioUnitScope in
         return noErr;
         break;
 
+      // rustomp patch (see patches/README.md):
+      // 只有当被托管的 CLAP 真的声明了 note port 时才对外宣称支持 MIDI 属性。
+      // 否则 Logic 会把一个纯音频效果器标记为 MIDIProtocol=1，
+      // 进而归类成 "MIDI 控制效果器"（在 Logic 里只出现在软件乐器插槽）。
       case kAudioUnitProperty_MIDIOutputCallbackInfo:
+        if (_midi_outports.empty()) return kAudioUnitErr_InvalidProperty;
         outDataSize = sizeof(CFArrayRef);
         outWritable = false;
         return noErr;
         break;
       case kAudioUnitProperty_MIDIOutputCallback:
+        if (_midi_outports.empty()) return kAudioUnitErr_InvalidProperty;
         outWritable = true;
         outDataSize = sizeof(AUMIDIOutputCallbackStruct);
         return noErr;
         break;
 #if AUSDK_MIDI2_AVAILABLE
       case kAudioUnitProperty_AudioUnitMIDIProtocol:
+        if (!hasMIDI()) return kAudioUnitErr_InvalidProperty;
         outWritable = false;
         outDataSize = sizeof(SInt32);
         return noErr;
         break;
       case kAudioUnitProperty_MIDIOutputEventListCallback:
+        if (_midi_outports.empty()) return kAudioUnitErr_InvalidProperty;
         outWritable = true;
         outDataSize = sizeof(AUMIDIEventListBlock);
         return noErr;
         break;
       case kAudioUnitProperty_HostMIDIProtocol:
+        if (!hasMIDI()) return kAudioUnitErr_InvalidProperty;
         outWritable = true;
         outDataSize = sizeof(SInt32);
         return noErr;
